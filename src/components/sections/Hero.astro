---
import Button from '@/components/ui/Button.astro'
import { Image } from 'astro:assets'
import YO from '@/assets/YO.jpeg'
---

<section id="inicio" class="scroll-mt-20">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-4 pb-16 pt-32 sm:px-6 md:min-h-[calc(100svh-5rem)] md:grid-cols-[minmax(0,1.15fr)_minmax(16rem,0.85fr)] md:gap-16 lg:px-8">
    <div class="min-w-0 rise-in">
      <p class="eyebrow mb-5 flex items-center gap-3">
        <span class="inline-block h-2 w-2 bg-accent shadow-[0_0_14px_var(--accent)]" aria-hidden="true"></span>
        IT Engineering Student / Fullstack / Security
      </p>
      <h1 class="mb-6 max-w-4xl text-5xl font-semibold leading-[0.95] tracking-[-0.065em] sm:text-6xl lg:text-7xl xl:text-8xl">
        Ricardo Reyes
        <span class="block text-accent">Gomez<span class="text-primary">.</span></span>
      </h1>
      <p class="mb-6 max-w-2xl text-lg leading-relaxed text-fg-secondary sm:text-xl">
        Construyo software con mentalidad <span class="font-semibold text-primary">Zero Trust</span>:
        verifico cada capa, reduzco superficies de ataque y busco sistemas claros, escalables y mantenibles.
      </p>
      <div class="mb-9 flex flex-wrap gap-2">
        <span class="border border-border px-3 py-1.5 font-mono text-xs text-fg-secondary">FULLSTACK</span>
        <span class="border border-border px-3 py-1.5 font-mono text-xs text-fg-secondary">SECURITY FIRST</span>
        <span class="border border-border px-3 py-1.5 font-mono text-xs text-fg-secondary">CLEAN CODE</span>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button href="#proyectos">Explorar proyectos <span aria-hidden="true">↗</span></Button>
        <a href="#contacto" class="px-2 py-2 text-sm font-medium text-fg-secondary hover:text-primary">
          Hablemos <span class="ml-1 text-accent" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="mt-12 font-mono text-xs text-fg-secondary">
        <span class="text-accent">&gt;</span> Don&apos;t trust, verify.
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-[22rem] rise-in delay-2 md:max-w-none">
      <div class="absolute -inset-4 border border-border" aria-hidden="true"></div>
      <div class="absolute -right-4 -top-4 z-20 h-16 w-16 border-r-2 border-t-2 border-accent" aria-hidden="true"></div>
      <div class="absolute -bottom-4 -left-4 z-20 h-16 w-16 border-b-2 border-l-2 border-accent" aria-hidden="true"></div>
      <div class="relative aspect-[4/5] overflow-hidden border border-border bg-secondary">
        <div class="absolute inset-0 z-10 bg-gradient-to-t from-black/70 via-transparent to-black/10" aria-hidden="true"></div>
        <Image
          src={YO}
          alt="Fotografía de Ricardo Reyes Gomez"
          class="h-full w-full object-cover grayscale transition duration-700 hover:scale-[1.03] hover:grayscale-0"
          loading="eager"
          decoding="async"
          format="avif"
          quality={90}
        />
        <div class="absolute bottom-0 left-0 z-20 flex w-full items-end justify-between p-5">
          <div>
            <p class="eyebrow mb-1">RyuheiRG</p>
            <p class="font-mono text-xs text-white/75">Building with intent.</p>
          </div>
          <span class="font-mono text-xs text-white/60">01 / 05</span>
        </div>
      </div>
    </div>
  </div>
</section>
