---
import SectionTitle from '@/components/ui/SectionTitle.astro'

const projects = [
  {
    title: 'frame-data-bayes',
    description:
      'Desarrollé Frame-Data-Bayes, un motor de análisis probabilístico y clasificación estadística desarrollado bajo estándares de Clean Code y mentalidad Zero Trust. El sistema trata cada dataset como un entorno hostil: valida superficies de entrada, detecta tipos de datos de forma determinística y aplica inferencia bayesiana para predecir eventos anómalos.',
    link: 'https://github.com/RyuheiRG/frame-data-bayes',
    tech: ['Python', 'Pandas', 'NumPy', 'Scikit-Learn', 'Streamlit', 'Matplotlib', 'Seaborn'],
  },
  {
    title: 'Event-Manager-Vite',
    description:
      'Migré una app creada con CRA a Vite. Event Manager es una aplicación para la gestión de eventos, desarrollada en React con TypeScript. Permite a los usuarios agregar, visualizar y eliminar eventos, mostrando detalles como nombre, fecha, hora y descripción del evento.',
    link: 'https://github.com/RyuheiRG/Event-Manager-Vite',
    tech: ['React', 'TypeScript', 'Vite', 'Redux Toolkit', 'MUI', 'Formik', 'Yup'],
  },
  {
    title: 'API-Rest-Cyber_LinKuei',
    description: 'Desarrollé una API Rest de los Cyber Lin Kuei.',
    link: 'https://github.com/RyuheiRG/API-Rest-Cyber_LinKuei',
    tech: ['Node.js', 'TypeScript', 'Express.js'],
  },
]
---

<section id="proyectos" class="scroll-mt-20">
  <div class="section-frame mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="eyebrow mb-3">Selected work / 03</p>
    <SectionTitle id="titulo-proyectos" title="Mis Proyectos" />
    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, index) => (
          <article class="panel-card flex min-h-full flex-col p-6">
            <div class="mb-8 flex items-center justify-between font-mono text-xs text-fg-secondary">
              <span>PROJECT / 0{index + 1}</span>
              <span class="text-accent" aria-hidden="true">↗</span>
            </div>
            <h3 class="mb-3 break-words text-xl font-semibold tracking-tight">{project.title}</h3>
            <p class="mb-6 flex-grow text-sm leading-relaxed text-fg-secondary">{project.description}</p>
            <div class="mt-auto border-t border-border pt-5">
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="mb-5 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-hover"
              >
                Ver repositorio <span aria-hidden="true">↗</span>
              </a>
              <ul class="flex flex-wrap gap-2 font-mono text-[0.68rem] text-fg-secondary">
                {project.tech.map((tech) => (
                  <li class="border border-border px-2 py-1">{tech}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
