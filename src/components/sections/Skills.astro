---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { Image } from "astro:assets";
import jsIcon from "@/assets/JavaScript.png";
import tsIcon from "@/assets/TypeScript.png";
import pyIcon from "@/assets/Python.png";
import cppIcon from "@/assets/CPlusPlus.png";
import vscodeIcon from "@/assets/VSCode.png";
import vercelIcon from "@/assets/Vercel.png";
import gitIcon from "@/assets/Git.png";
import githubIcon from "@/assets/GitHub.png";
import figmaIcon from "@/assets/Figma.png";
import tailwindIcon from "@/assets/TailwindCSS.png";
import astroIcon from "@/assets/Astro.png";
import reactIcon from "@/assets/React.png";
import nodejsIcon from "@/assets/Node.js.png";
import dockerIcon from "@/assets/Docker.png";
import postmanIcon from "@/assets/Postman.png";
import linuxIcon from "@/assets/Linux.png";
import ubuntuIcon from "@/assets/Ubuntu.png";
import expressIcon from "@/assets/Express.png";
import htmlIcon from "@/assets/HTML5.png";
import cssIcon from "@/assets/CSS3.png";
import jestIcon from "@/assets/Jest.png";
import mysqlIcon from "@/assets/MySQL.png";
import redisIcon from "@/assets/Redis.png";
import nginxIcon from "@/assets/Nginx.png";
import viteIcon from "@/assets/Vite.js.png";

const skills = [
  { name: "JavaScript", icon: jsIcon },
  { name: "TypeScript", icon: tsIcon },
  { name: "Python", icon: pyIcon },
  { name: "C++", icon: cppIcon },
  { name: "HTML5", icon: htmlIcon },
  { name: "CSS3", icon: cssIcon },
  { name: "React", icon: reactIcon },
  { name: "Node.js", icon: nodejsIcon },
  { name: "Express", icon: expressIcon },
  { name: "Tailwind CSS", icon: tailwindIcon },
  { name: "Astro", icon: astroIcon },
  { name: "Vite.js", icon: viteIcon },
  { name: "Docker", icon: dockerIcon },
  { name: "Postman", icon: postmanIcon },
  { name: "Linux", icon: linuxIcon },
  { name: "Ubuntu", icon: ubuntuIcon },
  { name: "Git", icon: gitIcon },
  { name: "GitHub", icon: githubIcon },
  { name: "Figma", icon: figmaIcon },
  { name: "Jest", icon: jestIcon },
  { name: "MySQL", icon: mysqlIcon },
  { name: "Redis", icon: redisIcon },
  { name: "Nginx", icon: nginxIcon },
  { name: "Vercel", icon: vercelIcon },
  { name: "VS Code", icon: vscodeIcon },
];
---

<section id="lenguajes" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <SectionTitle id="titulo-lenguajes" title="Lenguajes de Programación" />
    <div
      class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-4 sm:gap-5 mt-8"
    >
      {
        skills.map((skill) => (
          <div class="group flex flex-col items-center gap-2.5 rounded-md border border-border bg-secondary px-4 py-6 text-center transition-all duration-200 hover:-translate-y-1 hover:border-accent">
            <Image
              src={skill.icon}
              alt={`Logo del lenguaje ${skill.name}`}
              width={40}
              height={40}
              class="w-10 h-10 object-contain"
              loading="lazy"
              decoding="async"
              format="avif"
            />
            <p class="font-mono text-sm">{skill.name}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
