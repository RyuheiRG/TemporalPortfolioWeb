---
import SectionTitle from '@/components/ui/SectionTitle.astro'

const certifications = [
  {
    title: 'Operating Systems Support',
    issuer: 'Cisco',
    date: '2026-03-23',
    displayDate: '23/3/2026',
  },
  {
    title: 'Operating Systems Basics',
    issuer: 'Cisco',
    date: '2026-02-13',
    displayDate: '13/2/2026',
  },
  {
    title: 'AWS Academy Graduate - Cloud Foundations',
    issuer: 'Amazon Web Services Training and Certification',
    date: '2025-11-21',
    displayDate: '21/11/2025',
  },
  {
    title: 'Introduction to IoT',
    issuer: 'Cisco',
    date: '2025-11-19',
    displayDate: '19/11/2025',
  },
  {
    title: 'Networking Basics',
    issuer: 'Cisco',
    date: '2025-10-26',
    displayDate: '26/10/2025',
  },
]
---

<section id="certificaciones" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <SectionTitle id="titulo-certificaciones" title="Certificaciones y Cursos" />
    <div class="flex flex-col gap-3 mt-8">
      {
        certifications.map((cert) => (
          <article class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 rounded-r-md border border-l-4 border-border border-l-accent bg-secondary px-5 py-4">
            <div class="min-w-0">
              <h3 class="text-base font-semibold break-words">{cert.title}</h3>
              <p class="text-sm text-fg-secondary">{cert.issuer}</p>
            </div>
            <time class="font-mono text-sm text-accent flex-shrink-0" datetime={cert.date}>
              {cert.displayDate}
            </time>
          </article>
        ))
      }
    </div>
  </div>
</section>
