---
import SectionTitle from '@/components/ui/SectionTitle.astro'

const certifications = [
  {
    title: 'Operating Systems Support',
    issuer: 'Cisco',
    date: '2026-03-23',
    displayDate: '23/3/2026',
  },
  {
    title: 'Operating Systems Basics',
    issuer: 'Cisco',
    date: '2026-02-13',
    displayDate: '13/2/2026',
  },
  {
    title: 'AWS Academy Graduate - Cloud Foundations',
    issuer: 'Amazon Web Services Training and Certification',
    date: '2025-11-21',
    displayDate: '21/11/2025',
  },
  {
    title: 'Introduction to IoT',
    issuer: 'Cisco',
    date: '2025-11-19',
    displayDate: '19/11/2025',
  },
  {
    title: 'Networking Basics',
    issuer: 'Cisco',
    date: '2025-10-26',
    displayDate: '26/10/2025',
  },
]
---

<section id="certificaciones" class="scroll-mt-20">
  <div class="section-frame mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="eyebrow mb-3">Learning log / 04</p>
    <SectionTitle id="titulo-certificaciones" title="Certificaciones y Cursos" />
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      {
        certifications.map((cert, index) => (
          <article class="panel-card flex items-start justify-between gap-4 p-5">
            <div class="flex min-w-0 gap-4">
              <span class="font-mono text-xs text-accent">0{index + 1}</span>
              <div class="min-w-0">
                <h3 class="break-words text-sm font-semibold">{cert.title}</h3>
                <p class="mt-1 text-sm text-fg-secondary">{cert.issuer}</p>
              </div>
            </div>
            <time class="shrink-0 font-mono text-xs text-fg-secondary" datetime={cert.date}>
              {cert.displayDate}
            </time>
          </article>
        ))
      }
    </div>
  </div>
</section>
