---
import SectionTitle from '@/components/ui/SectionTitle.astro'
import { Image } from 'astro:assets'
import githubIcon from '@/assets/GitHub.png'
import linkedinIcon from '@/assets/LinkedIn.png'
import { siteConfig } from '@/config/site'
---

<section id="contacto" class="scroll-mt-20">
  <div class="section-frame mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="eyebrow mb-3">Open channel / 05</p>
    <SectionTitle id="titulo-contacto" title="Contacto" />
    <p class="mt-2 max-w-2xl text-lg text-fg-secondary">
      ¿Tienes una idea, una pregunta o simplemente quieres conectar? Encuéntrame aquí.
    </p>
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      <a
        href={siteConfig.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="panel-card flex min-h-24 items-center gap-4 px-5 py-4"
      >
        <Image
          src={linkedinIcon}
          alt=""
          width={32}
          height={32}
          class="h-8 w-8 object-contain"
          loading="lazy"
          decoding="async"
        />
        <span>
          <span class="block font-mono text-sm">LinkedIn</span>
          <span class="mt-1 block text-xs text-fg-secondary">Professional network ↗</span>
        </span>
      </a>
      <a
        href={siteConfig.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="panel-card flex min-h-24 items-center gap-4 px-5 py-4"
      >
        <Image
          src={githubIcon}
          alt=""
          width={32}
          height={32}
          class="h-8 w-8 object-contain"
          loading="lazy"
          decoding="async"
        />
        <span>
          <span class="block font-mono text-sm">GitHub</span>
          <span class="mt-1 block text-xs text-fg-secondary">Code & projects ↗</span>
        </span>
      </a>
    </div>
  </div>
</section>
