---
interface Props extends astroHTML.JSX.AnchorHTMLAttributes, astroHTML.JSX.ButtonHTMLAttributes {
  variant?: 'primary' | 'ghost'
  className?: string
  href?: string
  type?: 'button' | 'submit' | 'reset'
}

const {
  href,
  type = 'button',
  variant = 'primary',
  className = '',
  target,
  rel,
  ...rest
} = Astro.props

const baseClasses = 'inline-flex items-center justify-center min-h-[2.75rem] px-5 py-2.5 text-sm font-semibold rounded-sm transition-all duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent'

const variantClasses = {
  primary: 'border border-accent text-accent hover:text-accent-hover hover:bg-accent/10 hover:-translate-y-0.5',
  ghost: 'text-fg-secondary hover:text-accent',
}

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`
---

{href ? (
  <a
    href={href}
    class={classes}
    target={target}
    rel={rel}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <slot />
  </button>
)}
