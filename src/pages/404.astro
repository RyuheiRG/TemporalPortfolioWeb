---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { siteConfig } from '@/config/site'

const homeUrl = `${siteConfig.baseUrl}`
---

<BaseLayout title="404 | Página no encontrada" description="La página que buscas no existe.">
  <main class="min-h-screen flex flex-col items-center justify-center px-6">
    <div class="text-center space-y-6">
      <h1 class="text-6xl md:text-8xl font-semibold">404</h1>
      <h2 class="text-2xl md:text-3xl font-medium">Página no encontrada</h2>
      <p class="text-fg-secondary max-w-md mx-auto">
        La página que estás buscando no existe o ha sido movida.
      </p>
      <a
        href={homeUrl}
        class="inline-flex items-center justify-center px-6 py-3 border border-accent text-accent hover:text-accent-hover hover:bg-accent/10 rounded-sm transition-colors duration-200"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</BaseLayout>
